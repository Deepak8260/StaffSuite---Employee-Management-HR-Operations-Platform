# ---------------------------------------------------------------
# StaffSuite - repo-wide ignore rules
# (backend/ and frontend/ keep their own .gitignore too)
# ---------------------------------------------------------------

# --- Secrets & local configuration (never commit real values) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
application-local.properties
application-secrets.yml

# --- Uploaded files / runtime data ---
uploads/
**/uploads/

# --- Backend (Java / Maven) ---
backend/target/
**/target/
!**/src/**/target/
*.class
*.jar
*.war
!backend/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml

# --- Frontend (Node / Vite) ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.tsbuildinfo
.vite/
.eslintcache

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database dumps / local DB files ---
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# --- IDEs & editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath
.apt_generated
.sts4-cache
.springBeans
*.sw?
*.suo

# --- Claude Code local settings ---
.claude/settings.local.json

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
