# Documentation only. The application reads these from the process environment.
# Never treat values here as final or compiled-in.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/staffsuite?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRY_MS=3600000
FILE_STORAGE_PATH=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: creates the first SYSTEM_ADMIN on startup if the users table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@staffsuite.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Optional (default 30)
PASSWORD_RESET_EXPIRY_MINUTES=30
# Optional: where files are kept. "local" = the FILE_STORAGE_PATH directory (default)
STORAGE_TYPE=local
# Optional: default look-ahead (days) for the expiring-documents list
DOCUMENT_EXPIRY_WINDOW_DAYS=30
# Optional attendance rules (defaults shown)
ATTENDANCE_LATE_CUTOFF=09:30
ATTENDANCE_HALF_DAY_HOURS=4
ATTENDANCE_TIMEZONE=Asia/Kolkata
ATTENDANCE_CORRECTION_WINDOW_DAYS=30
